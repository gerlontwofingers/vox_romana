# vox_romana configuration
# Copy this file to ~/.vox_romana/config.yaml and edit as needed.
#
# CONFIG FILE PRECEDENCE
# ──────────────────────
# vox_romana looks for configuration in two places, in this order:
#
#   1. vox_romana.yaml  (project-root, next to run.py) — takes precedence.
#      Copy vox_romana.example.yaml to create this.  Gitignored.
#
#   2. ~/.vox_romana/config.yaml  (user home, system-wide) — fallback.
#      Copy THIS file to create this.  Useful for shared defaults across
#      multiple projects.
#
# Any key set in vox_romana.yaml overrides the same key in config.yaml.
#
# data_dir: Root directory for all runtime artifacts:
#             - vox_romana.db       (catalog / WPM stats)
#             - output/             (generated JSON scripts + audio)
#             - memory/             (ingest chunks, Chroma index, encoder, LM)
#             - piper-voices/       (TTS voice models, unless overridden below)
#
#           Defaults to ~/.vox_romana/ if not set.
#           Can also be overridden with the VOX_ROMANA_DATA_DIR env var.
data_dir: ~/.vox_romana

# piper_voices_dir: Path to Piper TTS voice models.
#                   Defaults to <data_dir>/piper-voices if not set.
#                   Override here if your models live on a different volume.
# piper_voices_dir: /Volumes/BigDisk/piper-voices

# ── LLM Lens Rack ──────────────────────────────────────────────────────
# Pick which LLM ("lens") drives each role.  Local lenses are creative
# instruments, not fallbacks — a small / brittle model is often the right
# voice for a flawed character (cf. Salvatore the polyglot lay brother in
# *The Name of the Rose* who mangles every language he attempts).
#
# Built-in lenses:
#   cloud-deepseek        — sober generalist (paid, default)
#   local-r1-distill      — sober reasoner; closest to the cloud lens
#   local-qwen-polyglot   — strong multilingual; codeswitches well
#   local-llama-dim       — small / brittle / sometimes naive
#                           (the "Salvatore lens")
#
# Local lenses require Ollama:  brew install ollama  &&  ollama pull <model>
# CLI overrides:  --llm-backend {cloud,local,auto}
#                 --llm-lens role=lens_name   (repeatable)
#
# llm:
#   default: cloud-deepseek
#   roles:
#     translator: local-qwen-polyglot
#     "character:Salvatore": local-llama-dim
#   # Optional: declare extra Ollama models as named lenses.
#   # lenses:
#   #   - name: local-mistral-small
#   #     backend: local
#   #     model: mistral-small:latest
#   #     personality_hint: "Terse French-leaning generalist."
#   #     language_strengths: [en, fr]
